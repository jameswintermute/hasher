# Runtime output
logs/
hashes/*.csv
hashes/partial-*.csv
zero-length/
quarantine*/

# Internal working state — keep the directory skeleton, not the contents
var/*
!var/*/
!var/**/.gitkeep

# Test sandboxes (harness uses mktemp, but --keep can leave these)
tests/.sandbox*

# Local, machine-specific config
local/

# OS / editor junk
.DS_Store
@eaDir/
#recycle/
*.swp
*~
